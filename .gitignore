# PHP
*.log
*.cache
vendor/
composer.lock
composer.phar
composer
.phpunit.cache/

# Vendored hotglue (hg/) app files ARE tracked, but its runtime content store
# and per-instance config (which carries the auth secret) are not.
/hg/content/
/hg/user-config.inc.php

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Environment and config
.env
.env.local
config.local.php
config.php

# Federation identity / log keys — generated by bin/init-identity and bin/init-log-key.
# Per-instance, never in source control.
secrets/

# Per-instance user data — MUST never enter source control (PII: editor
# emails/names inside snapshots, uploaded media). Lives in volumes/backups, not
# the repo. Also guarantees it can never reach the published Docker image, which
# CI builds from the tracked tree only.
uploads/
logs/
telaris-snapshots/

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Node modules (if any)
node_modules/
package-lock.json
yarn.lock

# Build files
dist/
build/
var/

# Planning docs
docs/planning/

# Vendored front-end libraries (PDF.js, Three.js build + addons, DaisyUI) are
# TRACKED even though `vendor/` and `build/` are ignored above. These negations
# are placed last so they override both patterns (last match wins), including
# the Three.js `build/` subdir. CI builds the published Docker image from the
# tracked tree, so these must be in git.
!js/vendor/
!js/vendor/**
!css/vendor/
!css/vendor/**

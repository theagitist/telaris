# Telaris instance — environment (copy to .env and edit). NEVER commit .env.
# Secrets stay here and in Docker volumes; they are never baked into the image.

# ---------------------------------------------------------------------------
# Which services run. Same `docker compose up -d` command in every mode; this
# one line decides bundled-vs-external DB and on-vs-off auto-TLS.
#   bundled-db,tls   local DB + automatic HTTPS  (full turnkey)
#   tls              external DB + automatic HTTPS
#   bundled-db       local DB, your own reverse proxy terminates TLS
#   (empty)          external DB, your own reverse proxy
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=bundled-db,tls

# Image source (published in CI to GHCR). Pin TELARIS_TAG to a released version
# for reproducible installs; `latest` tracks the newest published build.
TELARIS_APP_IMAGE=ghcr.io/theagitist/telaris-app
TELARIS_WEB_IMAGE=ghcr.io/theagitist/telaris-web
TELARIS_TAG=latest

# ---------------------------------------------------------------------------
# REQUIRED: every Telaris instance runs on its own stable, dedicated DNS name.
# This is the federation identity (peer key-ids are <hostname>:<fingerprint>)
# AND the hostname Caddy gets a TLS certificate for. Must resolve publicly to
# this host with ports 80 + 443 reachable when using the `tls` profile.
# ---------------------------------------------------------------------------
TELARIS_HOSTNAME=telaris.example.org
ACME_EMAIL=admin@example.org

# Host port the `web` service publishes (what your own reverse proxy targets;
# ignored if you only reach the instance through the bundled Caddy).
WEB_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# Database (PostgreSQL).
#   Bundled (COMPOSE_PROFILES includes bundled-db): keep DB_HOST=db. The bundled
#     PostgreSQL is created with DB_NAME / DB_USER / DB_PASS below.
#   External (no bundled-db): point DB_HOST/PORT at your server. For a managed
#     TLS database, set DB_SSL_CA to a CA path mounted into the app container
#     (see docker-compose.yml's commented ./certs volume).
# ---------------------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=telaris
DB_USER=telaris
DB_PASS=change-me-to-a-strong-password
# DB_SSL_CA=/certs/ca.pem

# ---------------------------------------------------------------------------
# Outgoing mail (password resets, account invites, federation drop notices).
# Leave blank to disable mail features.
# ---------------------------------------------------------------------------
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Telaris
MAIL_SMTP_SECURE=tls

# Comma-separated bridge plug-ins to enable (e.g. mocambos). Default: none.
TELARIS_BRIDGES=

# Cloudflare real-client-IP rewrite. Include from any Telaris vhost whose DNS
# A/AAAA is proxied through Cloudflare (orange-cloud). Without this snippet,
# $remote_addr is the CF edge IP — nginx rate limits, real_ip in logs, and
# the application-level throttles in utils/auth.php all act on CF
# infrastructure rather than real clients.
#
# Telaris specifically depends on this for the auth-throttle gate in
# utils/auth.php (auth_client_ip / api_client_ip). Both helpers read
# $_SERVER['REMOTE_ADDR'] directly and refuse to consult forwarded headers,
# because direct-to-origin requests can forge them. nginx is the right layer
# to decide whether a forwarded header is trustworthy — that's what
# real_ip_recursive + set_real_ip_from is for.
#
# Source: https://www.cloudflare.com/ips/
# When CF rotates ranges, refresh this file and reload nginx.
#
# Installation (one-time, requires root):
#
#   sudo cp etc/nginx/cloudflare-realip.conf.sample \
#        /etc/nginx/snippets/cloudflare-realip.conf
#   # then in each Telaris vhost server { ... } block, add:
#   #     include snippets/cloudflare-realip.conf;
#   sudo nginx -t && sudo systemctl reload nginx
#
# admin/setup.php (the install wizard) deliberately does NOT install this —
# the wizard runs as the web user without sudo, can't write /etc/nginx, can't
# reload the daemon. Track this as part of host provisioning instead.

# Cloudflare IPv4
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;

# Cloudflare IPv6
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;

real_ip_header CF-Connecting-IP;
real_ip_recursive on;
